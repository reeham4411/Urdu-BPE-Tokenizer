# Copy to .env and insert YOUR OWN contact email (Wikimedia policy).
WIKIMEDIA_CONTACT=your-email@example.com
USER_AGENT=UrduBPEStudentCorpus/1.0 (your-email@example.com) requests-python
# Per-request delay; be polite. Increase if needed; always respect 429 / Retry-After.
REQUEST_DELAY_SECONDS=2.0
MAXLAG_SECONDS=5
# Stop after this many decimal MB of saved UTF-8 text, not HTML (50 minimum).
TARGET_MB=55
MIN_URDU_RATIO=0.20
